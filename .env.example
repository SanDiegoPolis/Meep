# 网站对外源地址。部署时使用注册 OAuth 回调的 HTTPS 域名。
APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
SITE_TIME_ZONE=Asia/Shanghai
DATABASE_PATH=data/mianji.sqlite

# QQ 互联网站应用。回调路径 /auth/qq/callback
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# MUA 用户中心。回调路径 /auth/mua/callback
MUA_CLIENT_ID=
MUA_CLIENT_SECRET=
MUA_SCOPE=
MUA_PKCE=0
MUA_ID_FIELD=sub
MUA_NAME_FIELD=nickname
# 官方资料不含头像。只有实际返回头像字段时才填写。
MUA_AVATAR_FIELD=

# 以英文逗号分隔。登录后可在个人资料底部查看自己的账号标识。
ADMIN_ACCOUNTS=

# 以英文逗号分隔的可信反向代理 IP。仅在代理覆盖来自客户端的定位请求头时填写。
TRUST_PROXY=
# 可选 HTTPS IP 城市查询地址，路径或查询参数包含 {ip}。
GEOIP_URL=
